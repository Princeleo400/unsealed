# Required in production: a long random string used to sign play sessions.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Supabase (waitlist). Without these, dev mode stores the waitlist in .data/waitlist.jsonl
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Ad Manager rewarded web ad unit for hint videos, e.g. /1234567/unsealed_rewarded_hint
# Without it: development shows a 5-second test ad; production gives the hint with no ad.
NEXT_PUBLIC_GAM_REWARDED_AD_UNIT=
