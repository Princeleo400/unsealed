# Required in production: a long random string used to sign play sessions.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# Supabase. URL + publishable (anon) key switch on accounts; the secret (service role) key is for the
# waitlist and account deletion and must never be exposed to the browser.
# Without them: no sign-in, and dev stores the waitlist in .data/waitlist.jsonl
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Show social sign-in buttons only after enabling the provider in Supabase > Authentication > Providers
NEXT_PUBLIC_AUTH_GOOGLE=0
NEXT_PUBLIC_AUTH_APPLE=0

# Optional: change to make Daily Brief puzzles different from the defaults (keep it secret)
DAILY_SALT=

# Google Ad Manager rewarded web ad unit for hint videos, e.g. /1234567/unsealed_rewarded_hint
# Without it: development shows a 5-second test ad; production gives the hint with no ad.
NEXT_PUBLIC_GAM_REWARDED_AD_UNIT=

# ---- Payments (setup steps: docs/09-PAYMENTS-SETUP.md). Purchases also need SUPABASE_SERVICE_ROLE_KEY.
# Your public site address, used for checkout return links in production, e.g. https://unsealed.game
SITE_URL=
# Stripe (US$). Use the test keys (sk_test_…, whsec_…) until launch. Server only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paystack (Naira). Use the test secret key (sk_test_…) until launch. Server only.
PAYSTACK_SECRET_KEY=
# Paystack plan codes for the Case Pass (create the plans in the Paystack dashboard), e.g. PLN_abc123
PAYSTACK_PLAN_PASS_MONTHLY=
PAYSTACK_PLAN_PASS_ANNUAL=
